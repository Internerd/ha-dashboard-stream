#!/command/with-contenv bashio
# shellcheck shell=bash
set -e
# shellcheck disable=SC1091
. /data/dashboard-stream.env

bashio::log.info "Waiting ${RENDER_WAIT}s for the dashboard to render..."
sleep "${RENDER_WAIT}"

bashio::log.info "Waiting for mediamtx on 127.0.0.1:${RTSP_PORT}..."
for _ in $(seq 1 30); do
    nc -z 127.0.0.1 "${RTSP_PORT}" 2>/dev/null && break
    sleep 1
done

# -pkt_size 1400: ffmpeg's default RTP payload is larger than what the RTSP
# server accepts ("RTP packets are too big (1460 > 1440), remuxing them into
# smaller ones"), so it repacketises every frame. 1400 keeps the packets under
# that limit and comfortably inside a 1500-byte MTU on the way to the NVR.
#
# -profile:v: kept in step with what the ONVIF service advertises - libx264
# would otherwise default to High, leaving the stream and the device
# description disagreeing. Baseline is the default because that is what NVR
# decoders accept most reliably, and what a camera known to work with UniFi
# Protect delivers (profile-level-id 42C028 in its SDP).
bashio::log.info "Capturing ${DISPLAY} -> rtsp://127.0.0.1:${RTSP_PORT}/stream (${STREAM_WIDTH}x${STREAM_HEIGHT}@${STREAM_FRAMERATE})"
# -probesize: one raw 1920x1080 frame is ~8 MB, well over ffmpeg's 5 MB
# default, so the input probe never saw a full frame and warned "not enough
# frames to estimate rate". The rate is passed explicitly below anyway.
# A dashboard has no sound, but a video-only stream is unusual for a camera and
# some NVRs will not play one at all - hence a silent AAC track by default,
# which the ONVIF profile advertises alongside the video.
AUDIO_INPUT=()
AUDIO_ARGS=()
if [ "${AUDIO_TRACK:-silent}" = "silent" ]; then
    AUDIO_INPUT=(-f lavfi -i "anullsrc=channel_layout=mono:sample_rate=16000")
    AUDIO_ARGS=(-map 0:v:0 -map 1:a:0 -c:a aac -b:a 16k -ar 16000 -ac 1)
fi

exec ffmpeg -hide_banner -loglevel warning -nostdin \
    -probesize 64M \
    -f x11grab -draw_mouse 0 \
    -video_size "${STREAM_WIDTH}x${STREAM_HEIGHT}" -framerate "${STREAM_FRAMERATE}" -i "${DISPLAY}" \
    "${AUDIO_INPUT[@]}" \
    -c:v libx264 -preset veryfast -tune zerolatency -pix_fmt yuv420p \
    -profile:v "${H264_PROFILE:-baseline}" \
    -g "$((STREAM_FRAMERATE * 2))" -b:v 2500k -maxrate 3000k -bufsize 4000k \
    "${AUDIO_ARGS[@]}" \
    -f rtsp -rtsp_transport tcp -pkt_size 1400 \
    "rtsp://publisher:internal-publish-only@127.0.0.1:${RTSP_PORT}/stream"
