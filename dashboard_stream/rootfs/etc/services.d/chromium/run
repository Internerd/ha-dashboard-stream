#!/command/with-contenv bashio
# shellcheck shell=bash
set -e
# shellcheck disable=SC1091
. /data/dashboard-stream.env

mkdir -p /data/chromium-profile

bashio::log.info "Waiting for Xvfb..."
for _ in $(seq 1 30); do
    [ -S "/tmp/.X11-unix/X99" ] && break
    sleep 1
done

# Chromium probes both buses on startup. Starting it before they are up just
# reproduces the connection errors the buses exist to prevent.
bashio::log.info "Waiting for D-Bus..."
for _ in $(seq 1 30); do
    [ -S /run/dbus/system_bus_socket ] && [ -S /run/dbus/session_bus_socket ] && break
    sleep 1
done

bashio::log.info "Waiting for Home Assistant at ${HA_URL} ..."
for _ in $(seq 1 90); do
    if curl -sf -o /dev/null --max-time 3 "${HA_URL%/}/manifest.json"; then
        break
    fi
    sleep 2
done

CHROMIUM_BIN="$(command -v chromium || command -v chromium-browser || echo /usr/bin/chromium)"
bashio::log.info "Starting Chromium kiosk (binary: ${CHROMIUM_BIN}) -> ${DASHBOARD_URL}"

# Home Assistant's frontend follows the browser's prefers-color-scheme when the
# user's theme is set to Auto, and Chromium derives that from its native theme -
# which --force-dark-mode switches. There is no matching "force light" switch;
# light is what an unforced Chromium already reports.
COLOR_SCHEME_ARGS=()
if [ "${COLOR_SCHEME:-auto}" = "dark" ]; then
    COLOR_SCHEME_ARGS=(--force-dark-mode)
fi

# The commas below belong to --window-position/--window-size values, they do
# not separate array elements.
# shellcheck disable=SC2054
CHROMIUM_ARGS=( \
    --kiosk \
    --app="${DASHBOARD_URL}" \
    --window-position=0,0 \
    --window-size="${STREAM_WIDTH},${STREAM_HEIGHT}" \
    --user-data-dir=/data/chromium-profile \
    --remote-debugging-port=9222 \
    --remote-debugging-address=127.0.0.1 \
    --remote-allow-origins=* \
    --no-sandbox \
    --disable-gpu \
    --disable-software-rasterizer \
    --disable-dev-shm-usage \
    --disable-translate \
    --disable-infobars \
    --disable-session-crashed-bubble \
    --disable-notifications \
    --disable-features=TranslateUI \
    --autoplay-policy=no-user-gesture-required \
    --noerrdialogs \
    --check-for-update-interval=31536000 \
    --overscroll-history-navigation=0 \
    --start-fullscreen \
    --no-first-run \
    --no-default-browser-check \
    --password-store=basic \
    --disable-background-networking \
    --disable-component-update \
    --disable-client-side-phishing-detection \
    --disable-domain-reliability \
    --disable-sync \
    --disable-breakpad \
    --metrics-recording-only \
    "${COLOR_SCHEME_ARGS[@]}" \
)

# Chromium log levels: 0=INFO 1=WARNING 2=ERROR 3=FATAL. --log-level is only
# honoured once logging has been initialised (chrome/common/logging_chrome.cc
# applies it inside InitChromeLogging), hence the --enable-logging that goes
# with it. Outside debug, anything below FATAL is chatter from browser
# subsystems this kiosk does not use.
#
# The awk filter is the backstop: Chromium keeps trying to register with
# Google Cloud Messaging for the page's push subscription and logs
# DEPRECATED_ENDPOINT each time, and that survives both --log-level and
# --disable-background-networking. Nothing depends on it here, so drop just
# those lines; everything else Chromium says still reaches the log.
if [ "${LOG_LEVEL}" = "debug" ]; then
    exec "${CHROMIUM_BIN}" "${CHROMIUM_ARGS[@]}" --enable-logging=stderr --log-level=0
fi

exec "${CHROMIUM_BIN}" "${CHROMIUM_ARGS[@]}" --enable-logging=stderr --log-level=3 \
    2> >(awk '!/ERROR:(google_apis\/gcm|dbus)\//{ print; fflush() }' >&2)
