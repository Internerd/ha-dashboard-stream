#!/command/with-contenv bashio
# shellcheck shell=bash
set -e
# shellcheck disable=SC1091
. /data/dashboard-stream.env

bashio::log.info "Waiting ${RENDER_WAIT}s for the dashboard to render..."
sleep "${RENDER_WAIT}"

bashio::log.info "Waiting for mediamtx on 127.0.0.1:${RTSP_PORT}..."
for _ in $(seq 1 30); do
    nc -z 127.0.0.1 "${RTSP_PORT}" 2>/dev/null && break
    sleep 1
done

# -pkt_size 1400: ffmpeg's default RTP payload is larger than what the RTSP
# server accepts ("RTP packets are too big (1460 > 1440), remuxing them into
# smaller ones"), so it repacketises every frame. 1400 keeps the packets under
# that limit and comfortably inside a 1500-byte MTU on the way to the NVR.
#
# -profile:v: kept in step with what the ONVIF service advertises - libx264
# would otherwise default to High, leaving the stream and the device
# description disagreeing. Baseline is the default because that is what NVR
# decoders accept most reliably, and what a camera known to work with UniFi
# Protect delivers (profile-level-id 42C028 in its SDP).
bashio::log.info "Capturing ${DISPLAY} -> rtsp://127.0.0.1:${RTSP_PORT}/stream (${STREAM_WIDTH}x${STREAM_HEIGHT}@${STREAM_FRAMERATE})"
# -probesize: one raw 1920x1080 frame is ~8 MB, well over ffmpeg's 5 MB
# default, so the input probe never saw a full frame and warned "not enough
# frames to estimate rate". The rate is passed explicitly below anyway.
# A dashboard has no sound, but a video-only stream is unusual for a camera and
# some NVRs will not play one at all - hence a silent AAC track by default,
# which the ONVIF profiles advertise alongside the video.
AUDIO_INPUT=()
AUDIO_MAP=()
AUDIO_ENC=()
if [ "${AUDIO_TRACK:-silent}" = "silent" ]; then
    AUDIO_INPUT=(-f lavfi -i "anullsrc=channel_layout=mono:sample_rate=16000")
    AUDIO_MAP=(-map 1:a:0)
    AUDIO_ENC=(-c:a aac -b:a 16k -ar 16000 -ac 1)
fi

# Second, smaller output on /substream, published from the same capture.
# Cameras that UniFi Protect accepts all offer a main stream plus a substream
# and choose between them per view; the ONVIF service advertises this one as a
# second media profile. Both outputs come from one ffmpeg process, so if the
# capture dies the whole camera goes down at once (and s6 restarts it) rather
# than leaving one profile silently dead.
# -x264-params: two settings that make this stream look like a camera's
# rather than a screen recorder's, both measured with tools/compare_rtsp.py
# against a camera the NVR displays.
#   sliced-threads=0 - "-tune zerolatency" turns on sliced threads, which cuts
#     every frame into one slice per CPU core (four on a four-core host). A
#     camera sends one slice per frame, and a decoder that only handles that
#     shows nothing while happily holding the RTSP session open.
#   repeat-headers=1 - without it x264 puts SPS/PPS in the container header
#     only, so they reach a client in the SDP's sprop-parameter-sets and never
#     in the stream. A player reads them there; an NVR that expects a camera's
#     parameter sets ahead of every keyframe never gets a decodable frame.
X264_PARAMS="sliced-threads=0:repeat-headers=1"

SUB_OUTPUT=()
if [ "${SUBSTREAM:-true}" = "true" ]; then
    bashio::log.info "Also publishing rtsp://127.0.0.1:${RTSP_PORT}/substream (${SUB_WIDTH}x${SUB_HEIGHT}@${SUB_FRAMERATE})"
    SUB_OUTPUT=(
        -map 0:v:0 "${AUDIO_MAP[@]}"
        -filter:v "scale=${SUB_WIDTH}:${SUB_HEIGHT},fps=${SUB_FRAMERATE}"
        -c:v libx264 -preset veryfast -tune zerolatency -x264-params "${X264_PARAMS}"
        -pix_fmt yuv420p -profile:v "${H264_PROFILE:-baseline}"
        -g "$((SUB_FRAMERATE * 2))" -b:v 500k -maxrate 600k -bufsize 800k
        "${AUDIO_ENC[@]}"
        -f rtsp -rtsp_transport tcp -pkt_size 1400
        "rtsp://publisher:internal-publish-only@127.0.0.1:${RTSP_PORT}/substream"
    )
fi

# -thread_queue_size: the default of 8 frames is not enough for two encoders
# reading one capture - the grab thread blocks ("Thread message queue
# blocking"), timestamps then jump and ffmpeg fills the gaps with duplicated
# frames, which reaches the NVR as bursts several times faster than the
# configured rate. 512 frames of slack keeps both outputs at real time.
exec ffmpeg -hide_banner -loglevel warning -nostdin \
    -probesize 64M \
    -thread_queue_size 512 -f x11grab -draw_mouse 0 \
    -video_size "${STREAM_WIDTH}x${STREAM_HEIGHT}" -framerate "${STREAM_FRAMERATE}" -i "${DISPLAY}" \
    "${AUDIO_INPUT[@]}" \
    -map 0:v:0 "${AUDIO_MAP[@]}" \
    -c:v libx264 -preset veryfast -tune zerolatency -x264-params "${X264_PARAMS}" \
    -pix_fmt yuv420p -profile:v "${H264_PROFILE:-baseline}" \
    -g "$((STREAM_FRAMERATE * 2))" -b:v 2500k -maxrate 3000k -bufsize 4000k \
    "${AUDIO_ENC[@]}" \
    -f rtsp -rtsp_transport tcp -pkt_size 1400 \
    "rtsp://publisher:internal-publish-only@127.0.0.1:${RTSP_PORT}/stream" \
    "${SUB_OUTPUT[@]}"
